{
  // VS Code tasks виконуються з кореня workspace у devcontainer terminal.
  // Тут лишаються тільки базові команди: configure/build і clean.
  "version": "2.0.0",
  "tasks": [
    {
      // Default build task: Ctrl+Shift+B запускає debug preset, потім build.
      "label": "CMake: configure and build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Clean task навмисно простий: видаляється тільки локальна build директорія.
      "label": "CMake: clean build directory",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "make format",
      "type": "shell",
      "command": "clang-format -i homework_06_tests/FILES_CPP/*.cpp homework_06_tests/FILES_H/*.h && cmake-format -i CMakeLists.txt homework_06_tests/CMakeLists.txt",
      "group": {
          "kind": "build",
          "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Форматирование C++ (clang-format) и CMake (cmake-format) файлов"
    },
    {
      "label": "make lint",
      "type": "shell",
      "command": "run-clang-tidy-18 -p build/debug -fix -format -checks='modernize-*,bugprone-*,performance-*' homework_06_tests/*.cpp",
      "group": {
          "kind": "build",
          "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Статический анализ и автоисправление кода через clang-tidy"
    },
    {
      "label": "make test",
      "type": "shell",
      "command": "cmake --build build/debug --target ballistic_tests && ./build/debug/homework_06_tests/ballistic_tests",
      "group": "test",
      "problemMatcher": ["$gcc"],
      "detail": "Компиляция проекта и запуск Google Tests"
    },
    {
      "label": "make quality",
      "type": "shell",
      "dependsOrder": "sequence",
      "dependsOn": [
          "make format",
          "make lint",
          "make test"
      ],
      "group": {
          "kind": "build",
          "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Запуск полной цепочки: форматирование -> линтер -> тесты"
    }
  ]
}
