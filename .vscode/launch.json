{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Work with Debugger",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/DroneCourseHomework/executable",
            "args": ["Txt", "Table"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "sourceFileMap": {
                "${workspaceFolder}": "${workspaceFolder}"
            },
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: configure and build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable ASLR disabling in GDB",
                    "text": "set disable-randomization off", // GDB: don`t start randomization
                    "ignoreFailures": true
                }
            ]
        }
    ]
}