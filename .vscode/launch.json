{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug DroneCourseHomework (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/homework_10/executable",
            "args": ["DataFiles/json/config.json", "./homework_10/DataFiles/json/ammo.json", "DataFiles/json/targets.json", "./homework_10/DataFiles/json/output.json", "Table", "DataFiles/txt/BallisticTable.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: configure and build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable ASLR disabling in GDB",
                    "text": "-gdb-set disable-randomization off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod prompts in debugger sessions",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
