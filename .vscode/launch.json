{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug DroneCourseHomework (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/DroneCourseHomework/executable",
            "args": ["Txt", "Analytical"],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/home/rty6061944/CppMiltech/.vscode/gdb-no-debuginfod.sh",
            "preLaunchTask": "CMake: configure and build",
            "internalConsoleOptions": "openOnSessionStart",
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable ASLR disabling in GDB",
                    "text": "-gdb-set disable-randomization off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod prompts in batch/debugger sessions",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
