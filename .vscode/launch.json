{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Work with Debugger",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/homework_05/debugging",
            "args": ["./homework_05/data/bad_zero_delta.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: configure and build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}